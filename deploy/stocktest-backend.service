[Unit]
Description=StockTest FastAPI backend (uvicorn)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/opt/stocktest/web/backend
ExecStart=/opt/stocktest/.venv/bin/uvicorn app:app --host 127.0.0.1 --port 8000
Restart=on-failure
RestartSec=5
# Startup loads every price CSV and pre-warms MarketData for both universes
# (500+ tickers), which takes a while — don't let systemd kill it early.
TimeoutStartSec=600

[Install]
WantedBy=multi-user.target
